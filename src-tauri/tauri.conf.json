{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdminPack Explorer",
  "version": "0.2.2",
  "identifier": "com.logicalis.adminpack-explorer",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AdminPack Explorer",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#fafaf7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Browse AdminPack monitoring content",
    "longDescription": "AdminPack Explorer lets you browse, search, and inspect AdminPack monitoring definitions from the Logicalis NMS API.",
    "macOS": {
      "signingIdentity": "-",
      "providerShortName": null,
      "entitlements": null,
      "exceptionDomain": null,
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ryuuzaki1412/adminpack-explorer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQTE3NTA1OUYzNjhBRkYKUldUL2lqYWZCWFdoL1RqVFFlTUxOOTRqRnhkdmo0dUk2cy9CUUphbkJ0V3RJUTdGSU8xbDlSbU8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
